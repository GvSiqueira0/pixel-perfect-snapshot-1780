# Copy this file to `.env` and fill in the values.
#
# Quickstart (full instructions in README.md):
#   1. Create a free project at https://supabase.com
#   2. Dashboard -> Project Settings -> API: copy URL, publishable key, project ref
#   3. Dashboard -> Project Settings -> Database -> Connection string: copy the
#      **Session pooler** (IPv4) URI into SUPABASE_DB_URL so the `migrate`
#      service can apply drizzle/migrations on `docker compose up`.
#   4. Dashboard -> Authentication -> URL Configuration: add Redirect URLs
#      http://localhost:3000 (and http://localhost:8081 for the dev profile)
#   5. docker compose up -d web   (run from the repo root so this .env is read)
#
# The public VITE_* values are inlined into the client bundle at BUILD time,
# so they must be present when the image is built.
# The SUPABASE_* values are read at RUNTIME on the server (SSR).

# --- Public (safe to expose in the browser) ---
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# --- Server-side secrets (never expose to the browser) ---
# Required for server functions that use the admin client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Database migrations (used by the `migrate` compose service) ---
# Postgres connection string. Use the **Session pooler** (IPv4) URI from
# Dashboard -> Project Settings -> Database -> Connection string:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The direct host `db.<ref>.supabase.co` is IPv6-only and is NOT reachable from
# Docker without IPv6, so prefer the pooler string.
# Leave empty to skip migrations.
SUPABASE_DB_URL=""

# --- Optional: cron endpoint protection ---
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""

# --- Optional: database migrations via drizzle-kit (host tooling) ---
LOVABLE_DB_MIGRATION_URL=""
